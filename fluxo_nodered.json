        "name": "Temperature / Humidity Logs",
        "order": 5,
        "width": "6",
        "height": "5",
        "format": "<div style=\"font-family:monospace;font-size:12px\"><b>Logs (últimas 10 leituras)</b><div ng-repeat=\"l in msg.payload track by $index\">{{l}}</div></div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
