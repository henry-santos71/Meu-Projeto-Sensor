    {
        "id": "fn_log",
        "type": "function",
        "z": "tab_iot",
        "name": "Guardar Logs",
        "func": "var p = msg.payload.toString().split(',');\nvar logs = context.get('logs') || [];\nlogs.unshift(new Date().toLocaleTimeString('pt-BR') + '  |  Temp: ' + p[0] + ' °C  |  Umid: ' + p[1] + ' %');\nif (logs.length > 10) { logs.pop(); }\ncontext.set('logs', logs);\nmsg.payload = logs;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
        "y": 260,
        "wires": [
            [
                "tpl_logs"
            ]
        ]
    },
